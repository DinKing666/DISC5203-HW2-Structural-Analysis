#!/usr/bin/env python
import subprocess
import sys

checks = [
    [sys.executable, "HW1_reference/scripts/verify_outputs.py"],
    [sys.executable, "HW2/scripts/verify_hw2_outputs.py"],
]

for command in checks:
    result = subprocess.call(command)
    if result:
        raise SystemExit(result)

raise SystemExit(0)

